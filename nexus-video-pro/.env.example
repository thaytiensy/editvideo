# ==========================================
# NEXUS VIDEO PRO - ENVIRONMENT VARIABLES
# ==========================================

# 1. CORE SYSTEM & PORTS
NODE_ENV=production
PORT=3000
SERVER_PORT=8000
AI_ENGINE_PORT=8001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# 2. ADMIN AUTHENTICATION
SUPER_ADMIN_EMAIL=thaytiensy@gmail.com
SUPER_ADMIN_PASSWORD=12345678
JWT_SECRET=super_secret_nexus_video_pro_jwt_token_2026

# 3. REDIS & BULLMQ TASK QUEUES
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. S3 / MINIO / CLOUDFLARE R2 OBJECT STORAGE
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=nexus-video-renders
S3_FORCE_PATH_STYLE=true

# 5. GENERATIVE AI APIS & BYOK GATEWAYS
FAL_KEY=
REPLICATE_API_TOKEN=
RUNPOD_API_KEY=
KLING_API_KEY=
LUMA_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# 6. LOCAL AI PIPELINE SETTINGS
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
USE_LOCAL_CUDA=true
CUDA_VISIBLE_DEVICES=0
INSIGHTFACE_MODEL_PATH=./models/buffalo_l
INSWAPPER_MODEL_PATH=./models/inswapper_128.onnx
CODEFORMER_MODEL_PATH=./models/codeformer.pth
SAM2_CHECKPOINT_PATH=./models/sam2_hiera_large.pt
